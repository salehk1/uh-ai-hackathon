# Server-only settings for the Next.js adapter. Never prefix these with NEXT_PUBLIC_.
# The browser only calls this app's /api/* routes; it never needs database or LLM keys.

# Live mode: the teammate's FastAPI service (uvicorn api.main:app --port 8000).
# Production must use a reachable HTTPS URL, not localhost.
BACKEND_API_URL=http://127.0.0.1:8000

# Optional. Set to "fixtures" to serve labeled synthetic development data instead of the API.
# The UI shows a persistent banner in fixture mode. Live failures never fall back to fixtures.
# DATA_SOURCE=fixtures

# Optional, fixtures only: make the fixture analyst fail, to test chat failure isolation.
# FIXTURE_CHAT_FAIL=1
