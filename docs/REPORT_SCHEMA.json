{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Housing due-diligence report",
  "description": "POST /report. Three SEPARATE questions: price reasonableness, listing verification, cost transparency. No probability or confidence scores; missing evidence is the string \"unknown\".",
  "endpoint": {
    "method": "POST",
    "path": "/report",
    "request": {
      "type": "object",
      "properties": {
        "zpid": {
          "type": "integer"
        },
        "address": {
          "type": "string",
          "description": "street address; matched case-insensitively on the street part"
        },
        "asking_price": {
          "type": "number",
          "description": "optional override; recomputes verdict and costs"
        }
      },
      "anyOf": [
        {
          "required": [
            "zpid"
          ]
        },
        {
          "required": [
            "address"
          ]
        }
      ]
    },
    "errors": {
      "400": "neither zpid nor address",
      "404": "listing not found"
    }
  },
  "type": "object",
  "required": [
    "listing",
    "price",
    "verification",
    "costs",
    "sources",
    "limitations"
  ],
  "properties": {
    "listing": {
      "type": "object",
      "description": "Facts as listed on Zillow; any field may be null.",
      "properties": {
        "zpid": {},
        "street_address": {},
        "city": {},
        "state": {},
        "zipcode": {},
        "home_type": {},
        "beds": {},
        "baths": {},
        "living_area": {},
        "year_built": {},
        "lot_acres": {},
        "lat": {},
        "lon": {},
        "days_on_zillow": {},
        "page_views": {},
        "favorites": {},
        "agent_name": {},
        "broker_name": {},
        "mls_id": {},
        "photo_count": {},
        "date_posted": {},
        "hdp_url": {},
        "list_price": {}
      }
    },
    "price": {
      "type": "object",
      "required": [
        "asking",
        "fair",
        "q10",
        "q90",
        "verdict",
        "receipt",
        "comps"
      ],
      "properties": {
        "asking": {
          "type": "number"
        },
        "fair": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "q10": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "q90": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "high",
            "expected",
            "low",
            "unknown"
          ],
          "description": "high: asking > q90; low: asking < q10; unknown: listing outside model scope"
        },
        "asking_vs_fair_pct": {
          "type": "number"
        },
        "range_coverage": {
          "type": "number",
          "description": "measured out-of-fold share of homes whose asking price falls inside [q10,q90] (target 0.80); a property of the model, not of this listing"
        },
        "reason": {
          "type": "string",
          "description": "present when verdict is unknown"
        },
        "receipt": {
          "type": "array",
          "description": "items sum to fair",
          "items": {
            "type": "object",
            "required": [
              "feature",
              "pct",
              "usd"
            ],
            "properties": {
              "feature": {
                "type": "string",
                "description": "baseline | livingArea | age | school_mean | dist_downtown | bedrooms | bathrooms | other"
              },
              "label": {
                "type": "string"
              },
              "usd": {
                "type": "number"
              },
              "pct": {
                "type": "number",
                "description": "usd / fair x 100"
              }
            }
          }
        },
        "comps": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "zpid",
              "price",
              "ppsf",
              "dist_km",
              "beds",
              "baths",
              "sqft"
            ],
            "properties": {
              "zpid": {
                "type": "integer"
              },
              "price": {
                "type": "number"
              },
              "ppsf": {
                "type": "number"
              },
              "dist_km": {
                "type": "number"
              },
              "beds": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "baths": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "sqft": {
                "type": "number"
              },
              "home_type": {
                "type": "string"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            }
          }
        },
        "comps_rule": {
          "type": [
            "string",
            "null"
          ],
          "description": "similarity rule actually used (relaxed if too few matches)"
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "asking_far_below_range",
                  "duplicate_photos",
                  "duplicate_description",
                  "agent_broker_attribution",
                  "size_vs_comps",
                  "engagement_anomaly",
                  "address_disclosure"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "warning",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "string"
              },
              "related_zpids": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "costs": {
      "type": "object",
      "properties": {
        "monthly": {
          "type": "object",
          "required": [
            "mortgage",
            "tax",
            "hoa",
            "insurance",
            "total_known"
          ],
          "properties": {
            "mortgage": {
              "type": "number",
              "description": "principal + interest, 30-yr fixed, 20% down"
            },
            "tax": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "const": "unknown"
                }
              ]
            },
            "hoa": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "const": "unknown"
                }
              ]
            },
            "insurance": {
              "const": "unknown"
            },
            "total_known": {
              "type": "number",
              "description": "sum of the numeric items only"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "address_matches": {
      "type": "array",
      "description": "present only when an address matched several listings"
    },
    "photos": {
      "type": "array",
      "description": "The listing's own photos in listing order (scraped Zillow CDN URLs from the dataset snapshot; empty when the snapshot has none). thumb_url is ~800px wide for previews, full_url the largest copy.",
      "items": {
        "type": "object",
        "required": [
          "thumb_url",
          "full_url"
        ],
        "properties": {
          "thumb_url": {
            "type": "string",
            "pattern": "^https://photos\\.zillowstatic\\.com/"
          },
          "full_url": {
            "type": "string",
            "pattern": "^https://photos\\.zillowstatic\\.com/"
          },
          "full_width": {
            "type": "integer"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    }
  },
  "chat_visual": "POST /chat returns visuals[] with {type:'report', data:<this object>} when the agent calls the report tool",
