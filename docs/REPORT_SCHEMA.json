    "sources": [
      {
        "name": "Zillow listing snapshot",
        "detail": "Houston Housing Market 2024 dataset (Kaggle), scraped 2024-06-05",
        "license": "CC BY-NC-SA 4.0"
      },
      {
        "name": "Fair-price range",
        "detail": "LightGBM quantile models (q10/q50/q90), 5-fold spatial block CV, cross-fold conformal calibration; out-of-fold coverage 0.7998 (target 0.80)"
      },
      {
        "name": "Price receipt",
        "detail": "Geographically weighted regression (k=200, computed in q/kdb+); items sum to the fair price"
      },
      {
        "name": "Comparable homes",
        "detail": "Nearest listings in the same snapshot (asking prices, not sales)"
      },
      {
        "name": "Mortgage rate",
        "detail": "Zillow Home Loans 30-yr fixed rate embedded in the listing"
      }
    ],
    "limitations": [
      "Asking prices only; no closed-sale prices. 'Fair' means consistent with comparable listings.",
      "One snapshot (June 2024); no market trend adjustment.",
      "The 80% range is calibrated per home type across Houston; individual neighborhoods may be covered more or less often.",
      "Verification signals are evidence for a human to check, not a fraud score.",
      "No inspection, title, flood-zone, or permit data."
    ]
  }
}
